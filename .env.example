# Daytona HTTPS address that reaches the sandbox port 8080 proxy.
# Example shape: https://8080-<sandbox-id>.proxy.daytona.works
DAYTONA_AI_URL=https://YOUR-DAYTONA-8080-ENDPOINT

# Persistent key protecting the Daytona Node proxy (Authorization: Bearer).
DAYTONA_PROXY_KEY=YOUR_PRIVATE_PROXY_KEY

# Daytona preview token required by the standard preview URL
# (sent as the x-daytona-preview-token header).
DAYTONA_PREVIEW_TOKEN=YOUR_DAYTONA_PREVIEW_TOKEN

# Public-facing key for this Render gateway (Authorization: Bearer).
APP_API_KEY=YOUR_RENDER_GATEWAY_API_KEY

# Optional. Render sets PORT automatically; default is 10000.
# PORT=10000
